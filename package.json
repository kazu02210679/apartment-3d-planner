{
  "name": "apartment-3d-planner",
  "private": true,
  "version": "0.0.0",
  "description": "Local-first apartment and workstation 3D planner.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src e2e scripts vite.config.ts vitest.config.ts playwright.config.ts eslint.config.js",
    "format:check": "prettier --check package.json package-lock.json index.html tsconfig.json tsconfig.app.json vite.config.ts vitest.config.ts playwright.config.ts eslint.config.js .prettierrc.json README.md THIRD_PARTY_NOTICES.md docs/architecture.md docs/assets.md docs/catalog-extension.md docs/scene-format.md docs/reports/task-11-report.md docs/reports/task-12-report.md scripts/check-repo.ts scripts/notices.ts scripts/sample.ts scripts/serve-dist.ts src/release e2e/static-hosting.spec.ts .github/workflows/ci.yml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:evidence": "playwright test --project=evidence",
    "sample:generate": "tsx scripts/sample.ts generate",
    "sample:check": "tsx scripts/sample.ts check",
    "notices:generate": "tsx scripts/notices.ts generate",
    "notices:check": "tsx scripts/notices.ts check",
    "check:repo": "tsx scripts/check-repo.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.185.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.54.2",
    "@react-three/test-renderer": "^9.1.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
